def main():
    time = input("What time is it? ")
    time = convert(time)
    if time >= 7 and time <= 8:
        print("Breakfast Time")
    if time >= 12 and time <= 13:
        print("Lunch Time")
    if time >= 18 and time <= 19:
        print("Dinner Time")
    else:
        pass

def convert(time):
    hours, minutes = time.split(":")
    time = float(hours) + (float(minutes) / 60)
    return time


if __name__ == "__main__":
    main()
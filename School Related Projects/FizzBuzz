for i in range(1, 101): #puts the numbers 1 - 100
    if i % 3 == 0 and i % 5 == 0: #checks if I (which in this case is 1-100) is divisible by 3 and 5, if so, print FizzBuzz
        print("FizzBuzz")
    elif i % 3 == 0:
        print("Fizz")
    elif i % 5 == 0:
        print("Buzz")
    else:
        print(i)
